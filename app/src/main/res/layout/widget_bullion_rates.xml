<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_titanium"
    android:orientation="vertical"
    android:padding="8dp">

    <!-- Top Header Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widget_logo"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="KRS Logo"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_krs_app_logo" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="7dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="K.R.S. Live MCX"
                android:textColor="#FFFFFF"
                android:textSize="11.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🟢 Live 1s • KRS Live Feed"
                android:textColor="#FFD700"
                android:textSize="9sp" />
        </LinearLayout>

        <!-- Tap to Refresh Button -->
        <ImageView
            android:id="@+id/widget_btn_refresh"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:background="@drawable/bg_widget_refresh_btn"
            android:contentDescription="Refresh Rates"
            android:padding="4dp"
            android:src="@drawable/ic_widget_refresh" />
    </LinearLayout>

    <!-- Four Rates Grid: 2 Rows x 2 Columns -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="5dp"
        android:layout_marginBottom="4dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Row 1: Physical Bullion (GOLD 999 & SILVER 1KG) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <!-- Rate 1: Gold 999 (10g) -->
            <LinearLayout
                android:id="@+id/widget_gold_box"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="3dp"
                android:layout_marginBottom="2dp"
                android:layout_weight="1"
                android:background="@drawable/bg_widget_rate_card"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="3dp">

                <TextView
                    android:id="@+id/widget_gold_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="GOLD 999 (10g)"
                    android:textColor="#FFD700"
                    android:textSize="8.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_gold_price"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="₹1,46,040"
                    android:textColor="#FFFFFF"
                    android:textSize="13.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_gold_sub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Physical Spot"
                    android:textColor="#9E9EA8"
                    android:textSize="7.5sp" />
            </LinearLayout>

            <!-- Rate 2: Silver 1kg -->
            <LinearLayout
                android:id="@+id/widget_silver_box"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="3dp"
                android:layout_marginBottom="2dp"
                android:layout_weight="1"
                android:background="@drawable/bg_widget_rate_card"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="3dp">

                <TextView
                    android:id="@+id/widget_silver_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SILVER 1KG"
                    android:textColor="#E8E8E8"
                    android:textSize="8.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_silver_price"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="₹1,89,240"
                    android:textColor="#FFFFFF"
                    android:textSize="13.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_silver_sub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Physical Spot"
                    android:textColor="#9E9EA8"
                    android:textSize="7.5sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Row 2: International Spot Cent Rates (GOLD CENT $ & SILVER CENT $) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <!-- Rate 3: Gold Cent ($) -->
            <LinearLayout
                android:id="@+id/widget_mcx_gold_box"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginTop="2dp"
                android:layout_marginEnd="3dp"
                android:layout_weight="1"
                android:background="@drawable/bg_widget_rate_card"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="3dp">

                <TextView
                    android:id="@+id/widget_mcx_gold_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="GOLD CENT ($)"
                    android:textColor="#FFD700"
                    android:textSize="8.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_mcx_gold_price"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="$4,070.77"
                    android:textColor="#FFFFFF"
                    android:textSize="13.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_mcx_gold_sub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Spot Cent / Oz"
                    android:textColor="#81C784"
                    android:textSize="7.5sp" />
            </LinearLayout>

            <!-- Rate 4: Silver Cent ($) -->
            <LinearLayout
                android:id="@+id/widget_mcx_silver_box"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="3dp"
                android:layout_marginTop="2dp"
                android:layout_weight="1"
                android:background="@drawable/bg_widget_rate_card"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="3dp">

                <TextView
                    android:id="@+id/widget_mcx_silver_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SILVER CENT ($)"
                    android:textColor="#E8E8E8"
                    android:textSize="8.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_mcx_silver_price"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="$52.01"
                    android:textColor="#FFFFFF"
                    android:textSize="13.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_mcx_silver_sub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Spot Cent / Oz"
                    android:textColor="#81C784"
                    android:textSize="7.5sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Bottom Spot & Creator Footer Strip -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_spot_summary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Spot: $4070.77 • USD/INR ₹93.90"
            android:textColor="#888892"
            android:textSize="8sp" />

        <TextView
            android:id="@+id/widget_creator_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="By K.M. Jashwanth"
            android:textColor="#CCFFD700"
            android:textSize="8sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
