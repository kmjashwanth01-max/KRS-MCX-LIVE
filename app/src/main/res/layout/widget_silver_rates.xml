<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/silver_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_titanium"
    android:orientation="vertical"
    android:padding="10dp">

    <!-- Top Header Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/silver_widget_logo"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="KRS Silver Logo"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_krs_app_logo" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/silver_widget_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="K.R.S. Silver Live"
                android:textColor="#E2E8F0"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/silver_widget_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🟢 Live 1s • Silver Desk"
                android:textColor="#FFD700"
                android:textSize="9.5sp" />
        </LinearLayout>

        <!-- Tap to Refresh Button -->
        <ImageView
            android:id="@+id/silver_widget_btn_refresh"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/bg_widget_refresh_btn"
            android:contentDescription="Refresh Silver Rates"
            android:padding="5dp"
            android:src="@drawable/ic_widget_refresh" />
    </LinearLayout>

    <!-- Two Silver Rate Cards: SILVER MCX (1kg) & SILVER 1KG (Physical) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="6dp"
        android:layout_weight="1"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <!-- Box 1: SILVER MCX -->
        <LinearLayout
            android:id="@+id/silver_widget_mcx_box"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_widget_rate_card"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="6dp">

            <TextView
                android:id="@+id/silver_widget_mcx_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SILVER MCX (1kg)"
                android:textColor="#93C5FD"
                android:textSize="9.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/silver_widget_mcx_price"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="₹1,85,139"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/silver_widget_mcx_sub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="B:₹185,085 • A:₹185,139"
                android:textColor="#94A3B8"
                android:textSize="8sp" />
        </LinearLayout>

        <!-- Box 2: 1 KG SILVER (Physical) -->
        <LinearLayout
            android:id="@+id/silver_widget_physical_box"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_widget_rate_card"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="6dp">

            <TextView
                android:id="@+id/silver_widget_physical_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SILVER 1KG"
                android:textColor="#E2E8F0"
                android:textSize="9.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/silver_widget_physical_price"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="₹1,89,440"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/silver_widget_physical_sub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Physical Bar"
                android:textColor="#81C784"
                android:textSize="8sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Footer Strip -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/silver_widget_summary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Silver MCX + Physical 1kg • 1s Sync"
            android:textColor="#94A3B8"
            android:textSize="8sp" />

        <TextView
            android:id="@+id/silver_widget_creator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="By K.M. Jashwanth"
            android:textColor="#CCFFD700"
            android:textSize="8sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
